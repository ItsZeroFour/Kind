# Public URL of the production site (used for canonical URLs, sitemap, schema)
NEXT_PUBLIC_SITE_URL=https://kindappliancerepair.com

# Analytics & ads
# Google Tag Manager container (recommended: manage GA4, Ads, Pixel from GTM)
NEXT_PUBLIC_GTM_ID=
# GA4 Measurement ID: only if you are NOT using GTM
NEXT_PUBLIC_GA4_ID=
# Google Ads conversion (only if NOT using GTM): AW-XXXXXXXXX and the lead conversion label
NEXT_PUBLIC_GOOGLE_ADS_ID=
NEXT_PUBLIC_GOOGLE_ADS_LEAD_LABEL=
# Meta (Facebook/Instagram) Pixel ID: only if NOT loaded via GTM
NEXT_PUBLIC_META_PIXEL_ID=

# Call tracking
# CallRail / CallTrackingMetrics dynamic number insertion (DNI) script URL,
# e.g. //cdn.callrail.com/companies/XXXXXXXX/XXXXXXXXXXXX/12/swap.js
NEXT_PUBLIC_CALL_TRACKING_SCRIPT=

# Leads (form submissions)
LEAD_WEBHOOK_URL=
LEAD_WEBHOOK_SECRET=
RESEND_API_KEY=
LEAD_NOTIFY_EMAIL=
LEAD_FROM_EMAIL=

# Future modules
NEXT_PUBLIC_BOOKING_URL=
NEXT_PUBLIC_CHAT_WIDGET_SRC=

# SEO verification
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=

# Admin panel (/admin)
DATA_DIR=./data
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_COOKIE_SECURE=
ADMIN_TIMEZONE=America/Los_Angeles
